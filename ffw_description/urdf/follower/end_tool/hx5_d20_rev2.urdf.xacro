<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find robotis_hand_description)/urdf/hx5_d20_rev2/hx5_d20_left.urdf.xacro" />
  <xacro:include filename="$(find robotis_hand_description)/urdf/hx5_d20_rev2/hx5_d20_right.urdf.xacro" />

  <xacro:macro name="follower_end_tool" params="prefix">
    <joint name="${prefix}hx5_d20_left_joint" type="fixed">
      <parent link="${prefix}arm_l_link7"/>
      <child link="${prefix}hx5_d20_left_base"/>
      <origin xyz="0 0 -0.078" rpy="0 3.14159265359 1.5708"/>
    </joint>

    <xacro:hx5_d20_left prefix="${prefix}" />

    <joint name="${prefix}hx5_d20_right_joint" type="fixed">
      <parent link="${prefix}arm_r_link7"/>
      <child link="${prefix}hx5_d20_right_base"/>
      <origin xyz="0 0 -0.078" rpy="0 3.14159265359 -1.5708"/>
    </joint>

    <xacro:hx5_d20_right prefix="${prefix}" />
  </xacro:macro>
</robot>
