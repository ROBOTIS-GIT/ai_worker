<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="body_mount_xyz" value="-0.0753807 0 1.407" />
  <xacro:property name="body_mount_rpy" value="0 0 0" />
  <xacro:property name="base_meshes_dir" value="package://ffw_description/meshes/follower/base/ffw_swerve_f" />

  <xacro:macro name="follower_base" params="prefix">
    <link name="${prefix}base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${base_meshes_dir}/base_mobile_assy.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="silver">
          <color rgba="0.75 0.75 0.75 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${base_meshes_dir}/base_mobile_assy.stl" scale="0.001 0.001 0.001" />
        </geometry>
      </collision>
      <inertial>
         <origin xyz="-9.2151808e-02 -3.4302560e-04  1.6464288e-01" />
         <mass value="3.3618805e+01" />
         <inertia ixx="1.3486313e+00" ixy="4.0882867e-03" ixz="-3.4192770e-02"
         iyy="1.0032025e+00" iyz="-2.8882215e-03"
         izz="1.8044311e+00" />
      </inertial>
    </link>
  
    <joint name="${prefix}lidar_l_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}lidar_l_link"/>
      <origin xyz="-0.111881 0.240 0.34432" rpy="0 0 1.57079632679"/>
    </joint>
  
    <link name="${prefix}lidar_l_link">
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
      <visual>
        <geometry>
          <cylinder radius="0.03" length="0.03"/>
        </geometry>
      </visual>
    </link>
    <joint name="${prefix}lidar_r_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}lidar_r_link"/>
      <origin xyz="-0.111881 -0.240 0.34432" rpy="0 0 -1.57079632679"/>
    </joint>
    <!-- <link name="${prefix}lidar_r_link">
    </link> -->
  
    <joint name="${prefix}imu_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}imu_link"/>
      <origin xyz="-0.189181 0.0 0.247" rpy="0 0 0"/>
    </joint>
    <link name="${prefix}imu_link">
    </link>
    <link name="${prefix}lidar_r_link">
      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
      <visual>
        <geometry>
          <cylinder radius="0.03" length="0.03"/>
        </geometry>
        <material name="blue"><color rgba="0 0 1 1"/></material>
      </visual>
    </link>
    <link name="${prefix}lift_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${base_meshes_dir}/lift_link.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="silver">
          <color rgba="0.75 0.75 0.75 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${base_meshes_dir}/lift_link.stl" scale="0.001 0.001 0.001" />
        </geometry>
      </collision>
      <inertial>
         <origin xyz="-1.4244239e-01 -1.9465150e-05  7.5969115e-01 " />
         <mass value="2.3830693e+01" />
         <inertia ixx="3.7460504e+00" ixy="-3.0251097e-05" ixz="-1.5541068e-01"
                  iyy="3.7501190e+00" iyz="-1.5988249e-04"
                  izz="7.0266407e-02" />
      </inertial>
    </link>
    <joint name="${prefix}lift_fixed_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}lift_link"/>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    </joint>
  
  
    <joint name="${prefix}left_wheel_steer" type="revolute">
        <parent link="${prefix}base_link"/>
        <child link="${prefix}left_wheel_steer_link"/>
        <origin xyz="0.137119 0.2554 0.2613" rpy="0 0 0"/>
        <axis xyz="0 0 1" />
        <limit velocity="9999.0" effort="9999.0" lower="${-pi*6.0}" upper="${pi*6.0}" />
    </joint>
    <link name="${prefix}left_wheel_steer_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${base_meshes_dir}/left_wheel_steer_link.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="silver">
          <color rgba="0.75 0.75 0.75 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${base_meshes_dir}/left_wheel_steer_link.stl" scale="0.001 0.001 0.001" />
        </geometry>
      </collision>
      <inertial>
         <origin xyz="3.7980553e-05 -3.7540995e-02 -9.1472238e-02" />
         <mass value="7.6892793e-01" />
         <inertia ixx="2.4157274e-03" ixy="6.2656699e-07" ixz="-6.9428744e-07"
         iyy="2.0046567e-03" iyz="-6.3431544e-04"
         izz="9.6484794e-04" />
      </inertial>
    </link>
    <joint name="${prefix}left_wheel_drive" type="continuous">
        <parent link="${prefix}left_wheel_steer_link"/>
        <child link="${prefix}left_wheel_drive_link"/>
        <origin xyz="0 0 -0.1748" rpy="0 0 0"/>
        <axis xyz="0 1 0" />
        <limit velocity="9999.0" effort="9999.0"/>
    </joint>
    <link name="${prefix}left_wheel_drive_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${base_meshes_dir}/left_wheel_drive_link.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="silver">
          <color rgba="0.75 0.75 0.75 1"/>
        </material>
      </visual>
      <!-- <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${base_meshes_dir}/left_wheel_drive_link.stl" scale="0.001 0.001 0.001" />
        </geometry>
      </collision> -->
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="0.0865" length="0.05"/>
        </geometry>
      </collision>
      <inertial>
         <origin xyz="0.0000000e+00 -8.9131992e-05 -1.4447496e-05" />
         <mass value="3.6798216e+00" />
         <inertia ixx="6.8722244e-03" ixy="3.7858514e-07" ixz="0.0000000e+00"
         iyy="1.1250195e-02" iyz="-8.9789272e-06"
         izz="6.8707972e-03" />
      </inertial>
    </link>
  
    <joint name="${prefix}right_wheel_steer" type="revolute">
        <parent link="${prefix}base_link"/>
        <child link="${prefix}right_wheel_steer_link"/>
        <origin xyz="0.137119 -0.2554 0.2613" rpy="0 0 0"/>
        <axis xyz="0 0 1" />
        <limit velocity="9999.0" effort="9999.0" lower="${-pi*6.0}" upper="${pi*6.0}" />
    </joint>
    <link name="${prefix}right_wheel_steer_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${base_meshes_dir}/right_wheel_steer_link.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="silver">
          <color rgba="0.75 0.75 0.75 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${base_meshes_dir}/right_wheel_steer_link.stl" scale="0.001 0.001 0.001" />
        </geometry>
      </collision>
      <inertial>
         <origin xyz="-3.7980553e-05  3.7540995e-02 -9.1472238e-02" />
         <mass value="7.6892793e-01" />
         <inertia ixx="2.4157274e-03" ixy="6.2656699e-07" ixz="6.9428744e-07"
         iyy="2.0046567e-03" iyz="6.3431544e-04"
         izz="9.6484794e-04" />
      </inertial>
    </link>
    <joint name="${prefix}right_wheel_drive" type="continuous">
        <parent link="${prefix}right_wheel_steer_link"/>
        <child link="${prefix}right_wheel_drive_link"/>
        <origin xyz="0 0 -0.1748" rpy="0 0 0"/>
        <axis xyz="0 1 0" />
        <limit velocity="9999.0" effort="9999.0"/>
    </joint>
    <link name="${prefix}right_wheel_drive_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${base_meshes_dir}/right_wheel_drive_link.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="silver">
          <color rgba="0.75 0.75 0.75 1"/>
        </material>
      </visual>
      <!-- <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${base_meshes_dir}/right_wheel_drive_link.stl" scale="0.001 0.001 0.001" />
        </geometry>
      </collision> -->
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="0.0865" length="0.05"/>
        </geometry>
      </collision>
      <inertial>
         <origin xyz="0.0000000e+00  8.9131992e-05 -1.4447496e-05" />
         <mass value="3.6798216e+00" />
         <inertia ixx="6.8722244e-03" ixy="3.7858514e-07" ixz="0.0000000e+00"
         iyy="1.1250195e-02" iyz="8.9789272e-06"
         izz="6.8707972e-03" />
      </inertial>
    </link>
  
    <joint name="${prefix}rear_wheel_steer" type="revolute">
        <parent link="${prefix}base_link"/>
        <child link="${prefix}rear_wheel_steer_link"/>
        <origin xyz="-0.288133 0 0.2613" rpy="0 0 0"/>
        <axis xyz="0 0 1" />
        <limit velocity="9999.0" effort="9999.0" lower="${-pi*6.0}" upper="${pi*6.0}" />
    </joint>
    <link name="${prefix}rear_wheel_steer_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${base_meshes_dir}/rear_wheel_steer_link.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="silver">
          <color rgba="0.75 0.75 0.75 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${base_meshes_dir}/rear_wheel_steer_link.stl" scale="0.001 0.001 0.001" />
        </geometry>
      </collision>
      <inertial>
         <origin xyz="-3.7980553e-05  3.7540995e-02 -9.1472238e-02" />
         <mass value="7.6892793e-01" />
         <inertia ixx="2.4157274e-03" ixy="6.2656699e-07" ixz="6.9428744e-07"
         iyy="2.0046567e-03" iyz="6.3431544e-04"
         izz="9.6484794e-04" />
      </inertial>
    </link>
    <joint name="${prefix}rear_wheel_drive" type="continuous">
        <parent link="${prefix}rear_wheel_steer_link"/>
        <child link="${prefix}rear_wheel_drive_link"/>
        <origin xyz="0 0 -0.1748" rpy="0 0 0"/>
        <axis xyz="0 1 0" />
        <limit velocity="9999.0" effort="9999.0"/>
    </joint>
    <link name="${prefix}rear_wheel_drive_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${base_meshes_dir}/rear_wheel_drive_link.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="silver">
          <color rgba="0.75 0.75 0.75 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="0.0865" length="0.05"/>
        </geometry>
      </collision>
      <!-- <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${base_meshes_dir}/rear_wheel_drive_link.stl" scale="0.001 0.001 0.001" />
        </geometry>
      </collision> -->
      <inertial>
         <origin xyz="0.0000000e+00  8.9131992e-05 -1.4447496e-05" />
         <mass value="3.6798216e+00" />
         <inertia ixx="6.8722244e-03" ixy="3.7858514e-07" ixz="0.0000000e+00"
         iyy="1.1250196e-02" iyz="8.9836658e-06"
         izz="6.8708264e-03" />
      </inertial>
    </link>
  </xacro:macro>
</robot>
