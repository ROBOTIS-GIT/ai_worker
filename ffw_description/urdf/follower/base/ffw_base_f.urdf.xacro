<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="body_mount_xyz" value="0.0055 0 1.4316" />
  <xacro:property name="body_mount_rpy" value="0 0 0" />
  <xacro:property name="base_meshes_dir" value="package://ffw_description/meshes/follower/base/ffw_base_f" />

  <xacro:macro name="follower_base" params="prefix">
    <link name="world"/>
  
    <joint name="${prefix}world_fixed" type="fixed">
      <parent link="world"/>
      <child link="${prefix}base_link"/>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    </joint>
  
    <link name="${prefix}base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${base_meshes_dir}/base_mobile_assy.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="silver">
          <color rgba="0.75 0.75 0.75 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${base_meshes_dir}/base_mobile_assy.stl" scale="0.001 0.001 0.001" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-8.880608700e-03 -4.758427800e-03 3.886366400e-01" />
        <mass value="5.435831600e+01" />
        <inertia ixx="1.188633900e+06" ixy="6.334393100e+02" ixz="-1.454811600e+05"
        iyy="1.090949100e+06" iyz="-5.126785200e+03"
        izz="4.492808000e+05" />
      </inertial>
    </link>
  
  </xacro:macro>
</robot>
