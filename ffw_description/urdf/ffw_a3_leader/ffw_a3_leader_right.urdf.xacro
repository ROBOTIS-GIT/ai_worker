<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
   <xacro:macro name="a3_right" params="prefix">

      <link name="${prefix}a3_right_base" />

      <!-- Thumb -->
      <joint name="${prefix}finger_r_joint1" type="revolute">
         <parent link="${prefix}a3_right_base" />
         <child link="${prefix}finger_r_link1" />
         <origin xyz="0.06 0.0662 -0.00656" rpy="-0.96 0 0" />
         <axis xyz="0 1 0" />
         <limit velocity="4.8" effort="1000" lower="-1.57" upper="1.57" />
         <dynamics damping="0.05" />
      </joint>
      <link name="${prefix}finger_r_link1" />
      <joint name="${prefix}finger_r_joint2" type="revolute">
         <parent link="${prefix}finger_r_link1" />
