      <link name="${prefix}finger_r_link4" />
      <joint name="${prefix}finger_end_r_joint1" type="fixed">
         <parent link="${prefix}finger_r_link4" />
         <child link="${prefix}finger_end_r_link1" />
         <origin xyz="0.0 -0.0335 0.0" rpy="0 0 0" />
      </joint>
      <link name="${prefix}finger_end_r_link1" />

