         <axis xyz="1 0 0" />
         <limit velocity="4.8" effort="1000" lower="-1.57" upper="0.6" />
         <dynamics damping="0.05" />
      </joint>
      <link name="${prefix}finger_r_link2" />
      <joint name="${prefix}finger_r_joint3" type="revolute">
