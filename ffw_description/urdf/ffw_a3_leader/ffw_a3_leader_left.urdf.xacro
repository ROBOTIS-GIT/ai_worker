<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="a3_left" params="prefix">
    <!-- Left A3: link origins mirrored across the XZ plane from the right A3.
         Joint coordinates use positive local axes, with no encoder sign inversions. -->
    <link name="${prefix}a3_left_base" />
    <joint name="${prefix}finger_l_joint1" type="revolute">
      <parent link="${prefix}a3_left_base" />
      <child link="${prefix}finger_l_link1" />
      <origin xyz="0.06 -0.0662 -0.00656" rpy="0.96 0 0" />
      <axis xyz="0 1 0" />
      <limit velocity="4.8" effort="1000" lower="-1.57" upper="1.57" />
      <dynamics damping="0.05" />
    </joint>
    <link name="${prefix}finger_l_link1" />
    <joint name="${prefix}finger_l_joint2" type="revolute">
      <parent link="${prefix}finger_l_link1" />
      <child link="${prefix}finger_l_link2" />
      <origin xyz="0 0 0.02425" rpy="-0.96 0 0" />
      <axis xyz="1 0 0" />
      <!-- Positive local X reverses the mirrored coordinate: [-upper, -lower]. -->
      <limit velocity="4.8" effort="1000" lower="-0.6" upper="1.57" />
      <dynamics damping="0.05" />
    </joint>
    <link name="${prefix}finger_l_link2" />
    <joint name="${prefix}finger_l_joint3" type="revolute">
      <parent link="${prefix}finger_l_link2" />
      <child link="${prefix}finger_l_link3" />
      <origin xyz="0 0 0.065" rpy="0 0 0" />
      <axis xyz="1 0 0" />
      <limit velocity="4.8" effort="1000" lower="-1.57" upper="1.57" />
      <dynamics damping="0.05" />
    </joint>
    <link name="${prefix}finger_l_link3" />
    <joint name="${prefix}finger_l_joint4" type="revolute">
      <parent link="${prefix}finger_l_link3" />
      <child link="${prefix}finger_l_link4" />
      <origin xyz="0 0 0.1" rpy="0 0 0" />
      <axis xyz="1 0 0" />
      <limit velocity="4.8" effort="1000" lower="-1.57" upper="1.57" />
      <dynamics damping="0.05" />
    </joint>
    <link name="${prefix}finger_l_link4" />
    <joint name="${prefix}finger_end_l_joint1" type="fixed">
      <parent link="${prefix}finger_l_link4" />
      <child link="${prefix}finger_end_l_link1" />
      <origin xyz="0 0.0335 0" rpy="0 0 0" />
    </joint>
    <link name="${prefix}finger_end_l_link1" />
    <joint name="${prefix}finger_l_joint5" type="revolute">
      <parent link="${prefix}a3_left_base" />
      <child link="${prefix}finger_l_link5" />
      <origin xyz="-0.0065 -0.034 0.062" rpy="0 0 0" />
      <axis xyz="1 0 0" />
      <limit velocity="4.8" effort="1000" lower="-0.6" upper="0.6" />
      <dynamics damping="0.05" />
    </joint>
    <link name="${prefix}finger_l_link5" />
    <joint name="${prefix}finger_l_joint6" type="revolute">
      <parent link="${prefix}finger_l_link5" />
      <child link="${prefix}finger_l_link6" />
      <origin xyz="0 0 0.02425" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <limit velocity="4.8" effort="1000" lower="-1.57" upper="1.57" />
      <dynamics damping="0.05" />
    </joint>
    <link name="${prefix}finger_l_link6" />
    <joint name="${prefix}finger_l_joint7" type="revolute">
      <parent link="${prefix}finger_l_link6" />
      <child link="${prefix}finger_l_link7" />
      <origin xyz="0 0 0.065" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <limit velocity="4.8" effort="1000" lower="-1.57" upper="1.57" />
      <dynamics damping="0.05" />
    </joint>
    <link name="${prefix}finger_l_link7" />
    <joint name="${prefix}finger_l_joint8" type="revolute">
      <parent link="${prefix}finger_l_link7" />
      <child link="${prefix}finger_l_link8" />
      <origin xyz="0 0 0.1" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <limit velocity="4.8" effort="1000" lower="-1.57" upper="1.57" />
      <dynamics damping="0.05" />
    </joint>
    <link name="${prefix}finger_l_link8" />
    <joint name="${prefix}finger_end_l_joint2" type="fixed">
      <parent link="${prefix}finger_l_link8" />
      <child link="${prefix}finger_end_l_link2" />
      <origin xyz="0.0335 0 0" rpy="0 0 0" />
    </joint>
    <link name="${prefix}finger_end_l_link2" />
    <joint name="${prefix}finger_l_joint9" type="revolute">
      <parent link="${prefix}a3_left_base" />
      <child link="${prefix}finger_l_link9" />
      <origin xyz="-0.0065 -0.011 0.067" rpy="0 0 0" />
      <axis xyz="1 0 0" />
      <limit velocity="4.8" effort="1000" lower="-0.6" upper="0.6" />
      <dynamics damping="0.05" />
    </joint>
    <link name="${prefix}finger_l_link9" />
    <joint name="${prefix}finger_l_joint10" type="revolute">
      <parent link="${prefix}finger_l_link9" />
      <child link="${prefix}finger_l_link10" />
      <origin xyz="0 0 0.02425" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <limit velocity="4.8" effort="1000" lower="-1.57" upper="1.57" />
      <dynamics damping="0.05" />
    </joint>
    <link name="${prefix}finger_l_link10" />
    <joint name="${prefix}finger_l_joint11" type="revolute">
      <parent link="${prefix}finger_l_link10" />
      <child link="${prefix}finger_l_link11" />
      <origin xyz="0 0 0.065" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <limit velocity="4.8" effort="1000" lower="-1.57" upper="1.57" />
      <dynamics damping="0.05" />
    </joint>
    <link name="${prefix}finger_l_link11" />
    <joint name="${prefix}finger_l_joint12" type="revolute">
      <parent link="${prefix}finger_l_link11" />
      <child link="${prefix}finger_l_link12" />
      <origin xyz="0 0 0.1" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <limit velocity="4.8" effort="1000" lower="-1.57" upper="1.57" />
      <dynamics damping="0.05" />
    </joint>
    <link name="${prefix}finger_l_link12" />
    <joint name="${prefix}finger_end_l_joint3" type="fixed">
      <parent link="${prefix}finger_l_link12" />
      <child link="${prefix}finger_end_l_link3" />
      <origin xyz="0.0335 0 0" rpy="0 0 0" />
    </joint>
    <link name="${prefix}finger_end_l_link3" />
    <joint name="${prefix}finger_l_joint13" type="revolute">
      <parent link="${prefix}a3_left_base" />
      <child link="${prefix}finger_l_link13" />
      <origin xyz="-0.0065 0.012 0.062" rpy="0 0 0" />
      <axis xyz="1 0 0" />
      <limit velocity="4.8" effort="1000" lower="-0.6" upper="0.6" />
      <dynamics damping="0.05" />
    </joint>
    <link name="${prefix}finger_l_link13" />
    <joint name="${prefix}finger_l_joint14" type="revolute">
      <parent link="${prefix}finger_l_link13" />
      <child link="${prefix}finger_l_link14" />
      <origin xyz="0 0 0.02425" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <limit velocity="4.8" effort="1000" lower="-1.57" upper="1.57" />
      <dynamics damping="0.05" />
    </joint>
    <link name="${prefix}finger_l_link14" />
    <joint name="${prefix}finger_l_joint15" type="revolute">
      <parent link="${prefix}finger_l_link14" />
      <child link="${prefix}finger_l_link15" />
      <origin xyz="0 0 0.065" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <limit velocity="4.8" effort="1000" lower="-1.57" upper="1.57" />
      <dynamics damping="0.05" />
    </joint>
    <link name="${prefix}finger_l_link15" />
    <joint name="${prefix}finger_l_joint16" type="revolute">
      <parent link="${prefix}finger_l_link15" />
      <child link="${prefix}finger_l_link16" />
      <origin xyz="0 0 0.1" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <limit velocity="4.8" effort="1000" lower="-1.57" upper="1.57" />
      <dynamics damping="0.05" />
    </joint>
    <link name="${prefix}finger_l_link16" />
    <joint name="${prefix}finger_end_l_joint4" type="fixed">
      <parent link="${prefix}finger_l_link16" />
      <child link="${prefix}finger_end_l_link4" />
      <origin xyz="0.0335 0 0" rpy="0 0 0" />
    </joint>
    <link name="${prefix}finger_end_l_link4" />
    <joint name="${prefix}finger_l_joint17" type="revolute">
      <parent link="${prefix}a3_left_base" />
      <child link="${prefix}finger_l_link17" />
      <origin xyz="-0.0065 0.034 0.057" rpy="0 0 0" />
      <axis xyz="1 0 0" />
      <limit velocity="4.8" effort="1000" lower="-0.6" upper="0.6" />
      <dynamics damping="0.05" />
    </joint>
    <link name="${prefix}finger_l_link17" />
    <joint name="${prefix}finger_l_joint18" type="revolute">
      <parent link="${prefix}finger_l_link17" />
      <child link="${prefix}finger_l_link18" />
      <origin xyz="0 0 0.02425" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <limit velocity="4.8" effort="1000" lower="-1.57" upper="1.57" />
      <dynamics damping="0.05" />
    </joint>
    <link name="${prefix}finger_l_link18" />
    <joint name="${prefix}finger_l_joint19" type="revolute">
      <parent link="${prefix}finger_l_link18" />
      <child link="${prefix}finger_l_link19" />
      <origin xyz="0 0 0.065" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <limit velocity="4.8" effort="1000" lower="-1.57" upper="1.57" />
      <dynamics damping="0.05" />
    </joint>
    <link name="${prefix}finger_l_link19" />
    <joint name="${prefix}finger_l_joint20" type="revolute">
      <parent link="${prefix}finger_l_link19" />
      <child link="${prefix}finger_l_link20" />
      <origin xyz="0 0 0.09" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <limit velocity="4.8" effort="1000" lower="-1.57" upper="1.57" />
      <dynamics damping="0.05" />
    </joint>
    <link name="${prefix}finger_l_link20" />
    <joint name="${prefix}finger_end_l_joint5" type="fixed">
      <parent link="${prefix}finger_l_link20" />
      <child link="${prefix}finger_end_l_link5" />
      <origin xyz="0.0335 0 0" rpy="0 0 0" />
    </joint>
    <link name="${prefix}finger_end_l_link5" />
  </xacro:macro>
</robot>
