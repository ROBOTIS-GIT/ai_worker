<?xml version="1.0"?>
<robot name="a3_right" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="prefix" default="" />
  <xacro:arg name="port_name" default="/dev/ttyACM0" />
  <xacro:arg name="use_sim" default="false" />
  <xacro:arg name="use_mock_hardware" default="false" />
  <xacro:arg name="mock_sensor_commands" default="false" />

  <xacro:include filename="$(find ffw_description)/urdf/ffw_a3_leader/ffw_a3_leader_right.urdf.xacro" />

  <xacro:include filename="$(find ffw_description)/ros2_control/ffw_a3_leader/ffw_a3_leader_right.ros2_control.xacro" />

  <link name="world"/>

  <joint name="$(arg prefix)world_fixed" type="fixed">
    <parent link="world"/>
    <child link="$(arg prefix)a3_right_base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:a3_right prefix="$(arg prefix)" />
  <xacro:a3_right_system
    name="A3RightSystem" prefix="$(arg prefix)" port_name="$(arg port_name)" use_sim="$(arg use_sim)"
    use_mock_hardware="$(arg use_mock_hardware)"
    mock_sensor_commands="$(arg mock_sensor_commands)"/>

</robot>
