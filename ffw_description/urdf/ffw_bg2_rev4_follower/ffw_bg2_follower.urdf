      <param name="Feedforward 2nd Gain">30</param>
    </gpio>
  </ros2_control>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/root/ros2_ws/install/ffw_bringup/share/ffw_bringup/config/ffw_bg2_rev4_follower/ffw_bg2_follower_ai_hardware_controller.yaml</parameters>
    </plugin>
  </gazebo>
</robot>
