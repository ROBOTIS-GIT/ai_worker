<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ffw_f2_follower">
  <xacro:property name="meshes_file_direction" value="package://ffw_description/meshes/$(arg model)" />
  <xacro:property name="swerve_meshes_dir" value="package://ffw_description/meshes/common/follower/ffw_f_swerve" />
  <xacro:arg name="use_sim" default="false" />
  <xacro:arg name="use_mock_hardware" default="false" />
  <xacro:arg name="mock_sensor_commands" default="false" />
  <xacro:arg name="prefix" default="" />
  <xacro:arg name="model" default="ffw_f2_follower" />
  <xacro:arg name="ros2_control_type" default="ffw_f2_follower" />

  <xacro:include filename="$(find ffw_description)/urdf/common/follower/ffw_f_follower_body.xacro" />

  <!-- TODO: Change gripper to hx2_d1 -->
  <xacro:include filename="$(find ffw_description)/urdf/common/rh_p12_rn_a/rh_p12_rn_a.urdf.xacro" />

  <xacro:include filename="$(find ffw_description)/ros2_control/$(arg model)/$(arg ros2_control_type).ros2_control.xacro" />
  <xacro:include filename="$(find ffw_description)/ros2_control/$(arg model)/ffw_f2_base.ros2_control.xacro" />
  <xacro:include filename="$(find ffw_description)/ros2_control/$(arg model)/ffw_f2_sensor.ros2_control.xacro" />

  <xacro:include filename="$(find ffw_description)/gazebo/$(arg model)/ffw_f2_follower.gazebo.xacro" />

  <link name="$(arg prefix)base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/base_mobile_assy.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="silver">
        <color rgba="0.75 0.75 0.75 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/base_mobile_assy.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <inertial>
       <origin xyz="-9.2151808e-02 -3.4302560e-04  1.6464288e-01" />
       <mass value="3.3618805e+01" />
       <inertia ixx="1.3486313e+00" ixy="4.0882867e-03" ixz="-3.4192770e-02"
       iyy="1.0032025e+00" iyz="-2.8882215e-03"
       izz="1.8044311e+00" />
    </inertial>
  </link>

  <joint name="$(arg prefix)lidar_l_joint" type="fixed">
    <parent link="$(arg prefix)base_link"/>
    <child link="$(arg prefix)lidar_l_link"/>
    <origin xyz="-0.111881 0.240 0.34432" rpy="0 0 1.57079632679"/>
  </joint>

  <link name="$(arg prefix)lidar_l_link">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.03"/>
      </geometry>
    </visual>
  </link>
  <joint name="$(arg prefix)lidar_r_joint" type="fixed">
    <parent link="$(arg prefix)base_link"/>
    <child link="$(arg prefix)lidar_r_link"/>
    <origin xyz="-0.111881 -0.240 0.34432" rpy="0 0 -1.57079632679"/>
  </joint>
  <!-- <link name="$(arg prefix)lidar_r_link">
  </link> -->

  <joint name="$(arg prefix)imu_joint" type="fixed">
    <parent link="$(arg prefix)base_link"/>
    <child link="$(arg prefix)imu_link"/>
    <origin xyz="-0.189181 0.0 0.247" rpy="0 0 0"/>
  </joint>
  <link name="$(arg prefix)imu_link">
  </link>
  <link name="$(arg prefix)lidar_r_link">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.03"/>
      </geometry>
      <material name="blue"><color rgba="0 0 1 1"/></material>
    </visual>
  </link>
  <link name="$(arg prefix)lift_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/lift_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="silver">
        <color rgba="0.75 0.75 0.75 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/lift_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <inertial>
       <origin xyz="-1.4244239e-01 -1.9465150e-05  7.5969115e-01 " />
       <mass value="2.3830693e+01" />
       <inertia ixx="3.7460504e+00" ixy="-3.0251097e-05" ixz="-1.5541068e-01"
                iyy="3.7501190e+00" iyz="-1.5988249e-04"
                izz="7.0266407e-02" />
    </inertial>
  </link>
  <joint name="$(arg prefix)lift_fixed_joint" type="fixed">
    <parent link="$(arg prefix)base_link"/>
    <child link="$(arg prefix)lift_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo plugins/sensors -->
  <xacro:ffw_f2_follower_gazebo prefix="$(arg prefix)" />

  <xacro:ffw_f_follower_body parent="$(arg prefix)base_link" prefix="$(arg prefix)">
    <origin xyz="-0.0753807 0 1.407" rpy="0 0 0" />
  </xacro:ffw_f_follower_body>

  <!-- TODO: Change gripper to hx2_d1 -->
  <xacro:rh_p12_rn_a parent="$(arg prefix)arm_l_link7" prefix="$(arg prefix)gripper_l_">
    <origin xyz="0 0 -0.078" rpy="0 3.14159265359 3.14159265359"/>
  </xacro:rh_p12_rn_a>

  <joint name="$(arg prefix)end_effector_l_joint" type="fixed">
    <parent link="$(arg prefix)arm_l_link7"/>
    <child link="$(arg prefix)end_effector_l_link"/>
    <origin xyz="0 0 -0.215" rpy="0 0 0"/>
  </joint>

  <link name="$(arg prefix)end_effector_l_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01" />
      </geometry>
      <material name="red">
        <color rgba="1.0 0.0 0.0 1"/>
      </material>
    </visual>
  </link>

  <!-- TODO: Change gripper to hx2_d1 -->
  <xacro:rh_p12_rn_a parent="$(arg prefix)arm_r_link7" prefix="$(arg prefix)gripper_r_">
    <origin xyz="0 0 -0.078" rpy="0 3.14159265359 3.14159265359"/>
  </xacro:rh_p12_rn_a>

  <joint name="$(arg prefix)end_effector_r_joint" type="fixed">
    <parent link="$(arg prefix)arm_r_link7"/>
    <child link="$(arg prefix)end_effector_r_link"/>
    <origin xyz="0 0 -0.215" rpy="0 0 0"/>
  </joint>

  <link name="$(arg prefix)end_effector_r_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01" />
      </geometry>
      <material name="red">
        <color rgba="1.0 0.0 0.0 1"/>
      </material>
    </visual>
  </link>

  <joint name="$(arg prefix)left_wheel_steer" type="revolute">
      <parent link="$(arg prefix)base_link"/>
      <child link="$(arg prefix)left_wheel_steer_link"/>
      <origin xyz="0.137119 0.2554 0.2613" rpy="0 0 0"/>
      <axis xyz="0 0 1" />
      <limit velocity="9999.0" effort="9999.0" lower="${-pi*6.0}" upper="${pi*6.0}" />
  </joint>
  <link name="$(arg prefix)left_wheel_steer_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/left_wheel_steer_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="silver">
        <color rgba="0.75 0.75 0.75 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/left_wheel_steer_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <inertial>
       <origin xyz="3.7980553e-05 -3.7540995e-02 -9.1472238e-02" />
       <mass value="7.6892793e-01" />
       <inertia ixx="2.4157274e-03" ixy="6.2656699e-07" ixz="-6.9428744e-07"
       iyy="2.0046567e-03" iyz="-6.3431544e-04"
       izz="9.6484794e-04" />
    </inertial>
  </link>
  <joint name="$(arg prefix)left_wheel_drive" type="continuous">
      <parent link="$(arg prefix)left_wheel_steer_link"/>
      <child link="$(arg prefix)left_wheel_drive_link"/>
      <origin xyz="0 0 -0.1748" rpy="0 0 0"/>
      <axis xyz="0 1 0" />
      <limit velocity="9999.0" effort="9999.0"/>
  </joint>
  <link name="$(arg prefix)left_wheel_drive_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/left_wheel_drive_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="silver">
        <color rgba="0.75 0.75 0.75 1"/>
      </material>
    </visual>
    <!-- <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/left_wheel_drive_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision> -->
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0865" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
       <origin xyz="0.0000000e+00 -8.9131992e-05 -1.4447496e-05" />
       <mass value="3.6798216e+00" />
       <inertia ixx="6.8722244e-03" ixy="3.7858514e-07" ixz="0.0000000e+00"
       iyy="1.1250195e-02" iyz="-8.9789272e-06"
       izz="6.8707972e-03" />
    </inertial>
  </link>

  <joint name="$(arg prefix)right_wheel_steer" type="revolute">
      <parent link="$(arg prefix)base_link"/>
      <child link="$(arg prefix)right_wheel_steer_link"/>
      <origin xyz="0.137119 -0.2554 0.2613" rpy="0 0 0"/>
      <axis xyz="0 0 1" />
      <limit velocity="9999.0" effort="9999.0" lower="${-pi*6.0}" upper="${pi*6.0}" />
  </joint>
  <link name="$(arg prefix)right_wheel_steer_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/right_wheel_steer_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="silver">
        <color rgba="0.75 0.75 0.75 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/right_wheel_steer_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <inertial>
       <origin xyz="-3.7980553e-05  3.7540995e-02 -9.1472238e-02" />
       <mass value="7.6892793e-01" />
       <inertia ixx="2.4157274e-03" ixy="6.2656699e-07" ixz="6.9428744e-07"
       iyy="2.0046567e-03" iyz="6.3431544e-04"
       izz="9.6484794e-04" />
    </inertial>
  </link>
  <joint name="$(arg prefix)right_wheel_drive" type="continuous">
      <parent link="$(arg prefix)right_wheel_steer_link"/>
      <child link="$(arg prefix)right_wheel_drive_link"/>
      <origin xyz="0 0 -0.1748" rpy="0 0 0"/>
      <axis xyz="0 1 0" />
      <limit velocity="9999.0" effort="9999.0"/>
  </joint>
  <link name="$(arg prefix)right_wheel_drive_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/right_wheel_drive_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="silver">
        <color rgba="0.75 0.75 0.75 1"/>
      </material>
    </visual>
    <!-- <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/right_wheel_drive_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision> -->
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0865" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
       <origin xyz="0.0000000e+00  8.9131992e-05 -1.4447496e-05" />
       <mass value="3.6798216e+00" />
       <inertia ixx="6.8722244e-03" ixy="3.7858514e-07" ixz="0.0000000e+00"
       iyy="1.1250195e-02" iyz="8.9789272e-06"
       izz="6.8707972e-03" />
    </inertial>
  </link>

  <joint name="$(arg prefix)rear_wheel_steer" type="revolute">
      <parent link="$(arg prefix)base_link"/>
      <child link="$(arg prefix)rear_wheel_steer_link"/>
      <origin xyz="-0.288133 0 0.2613" rpy="0 0 0"/>
      <axis xyz="0 0 1" />
      <limit velocity="9999.0" effort="9999.0" lower="${-pi*6.0}" upper="${pi*6.0}" />
  </joint>
  <link name="$(arg prefix)rear_wheel_steer_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/rear_wheel_steer_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="silver">
        <color rgba="0.75 0.75 0.75 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/rear_wheel_steer_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
    <inertial>
       <origin xyz="-3.7980553e-05  3.7540995e-02 -9.1472238e-02" />
       <mass value="7.6892793e-01" />
       <inertia ixx="2.4157274e-03" ixy="6.2656699e-07" ixz="6.9428744e-07"
       iyy="2.0046567e-03" iyz="6.3431544e-04"
       izz="9.6484794e-04" />
    </inertial>
  </link>
  <joint name="$(arg prefix)rear_wheel_drive" type="continuous">
      <parent link="$(arg prefix)rear_wheel_steer_link"/>
      <child link="$(arg prefix)rear_wheel_drive_link"/>
      <origin xyz="0 0 -0.1748" rpy="0 0 0"/>
      <axis xyz="0 1 0" />
      <limit velocity="9999.0" effort="9999.0"/>
  </joint>
  <link name="$(arg prefix)rear_wheel_drive_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/rear_wheel_drive_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="silver">
        <color rgba="0.75 0.75 0.75 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0865" length="0.05"/>
      </geometry>
    </collision>
    <!-- <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${swerve_meshes_dir}/rear_wheel_drive_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision> -->
    <inertial>
       <origin xyz="0.0000000e+00  8.9131992e-05 -1.4447496e-05" />
       <mass value="3.6798216e+00" />
       <inertia ixx="6.8722244e-03" ixy="3.7858514e-07" ixz="0.0000000e+00"
       iyy="1.1250196e-02" iyz="8.9836658e-06"
       izz="6.8708264e-03" />
    </inertial>
  </link>

  <xacro:ffw_f2_follower_system
    use_sim="$(arg use_sim)"
    use_mock_hardware="$(arg use_mock_hardware)"
    mock_sensor_commands="$(arg mock_sensor_commands)"/>

  <xacro:ffw_f2_base_system
    use_sim="$(arg use_sim)"
    use_mock_hardware="$(arg use_mock_hardware)"
    mock_sensor_commands="$(arg mock_sensor_commands)"/>

  <xacro:ffw_f2_sensor_system
    use_sim="$(arg use_sim)"
    use_mock_hardware="$(arg use_mock_hardware)"
    mock_sensor_commands="$(arg mock_sensor_commands)"/>

  <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find ffw_bringup)/config/$(arg model)/ffw_f2_follower_ai_hardware_controller.yaml</parameters>
      </plugin>
  </gazebo>

</robot>
