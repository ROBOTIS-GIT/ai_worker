<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="pedal">
  <xacro:arg name="port_name" default=""/>
  <xacro:arg name="baud_rate" default="1000000"/>
  <xacro:arg name="use_mock_hardware" default="false"/>

  <link name="pedal_base_link"/>
  <link name="pedal_link"/>
  <joint name="pedal_joint" type="revolute">
    <parent link="pedal_base_link"/>
    <child link="pedal_link"/>
    <axis xyz="1 0 0"/>
    <limit velocity="4.8" effort="1" lower="${-pi*100.0}" upper="${pi*100.0}"/>
  </joint>

  <ros2_control name="pedal" type="system">
    <hardware>
      <xacro:if value="$(arg use_mock_hardware)">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:if>
      <xacro:unless value="$(arg use_mock_hardware)">
        <plugin>dynamixel_hardware_interface/DynamixelHardware</plugin>
        <param name="port_name">$(arg port_name)</param>
        <param name="baud_rate">$(arg baud_rate)</param>
        <param name="dynamixel_model_folder">/param/dxl_model</param>
        <param name="number_of_joints">1</param>
        <param name="number_of_transmissions">1</param>
        <param name="disable_torque_at_init">true</param>
        <param name="dynamixel_state_pub_msg_name">dynamixel_hardware_interface/dxl_state</param>
        <param name="get_dynamixel_data_srv_name">dynamixel_hardware_interface/get_dxl_data</param>
        <param name="set_dynamixel_data_srv_name">dynamixel_hardware_interface/set_dxl_data</param>
        <param name="reboot_dxl_srv_name">dynamixel_hardware_interface/reboot_dxl</param>
        <param name="set_dxl_torque_srv_name">dynamixel_hardware_interface/set_dxl_torque</param>
      </xacro:unless>
    </hardware>
    <joint name="pedal_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.5</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <gpio name="dxl1">
      <param name="type">dxl</param>
      <param name="ID">1</param>
      <command_interface name="Goal Position"/>
      <state_interface name="Present Position"/>
      <state_interface name="Present Velocity"/>
      <param name="Operating Mode">5</param>
      <param name="Current Limit">500</param>
      <param name="Return Delay Time">0</param>
      <param name="Position P Gain">800</param>
      <param name="Position D Gain">800</param>
    </gpio>
  </ros2_control>
</robot>
