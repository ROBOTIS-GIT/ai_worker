<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find robotis_hand_description)/ros2_control/hx5_d20_rev2/hx5_d20_left.joints.xacro" />
  <xacro:include filename="$(find robotis_hand_description)/ros2_control/hx5_d20_rev2/hx5_d20_right.joints.xacro" />

  <xacro:property name="follower_end_tool_joint_count" value="40" />

  <xacro:macro name="follower_end_tool_joints">
    <xacro:hx5_right_joints />
    <xacro:hx5_left_joints />
  </xacro:macro>
</robot>
