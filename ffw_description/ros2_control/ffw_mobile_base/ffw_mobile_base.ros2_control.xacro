<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="ffw_mobile_base_steer_system" params="use_sim:=^|false use_mock_hardware:=^|false mock_sensor_commands:=^|false port_name:=^|/dev/follower">
    <ros2_control name="ffw_mobile_base_steer" type="system" is_async="true">
      <xacro:if value="$(arg use_sim)">
        <hardware>
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
      </xacro:if>
      <xacro:unless value="$(arg use_sim)">
        <hardware>
          <xacro:if value="${use_mock_hardware}">
            <plugin>mock_components/GenericSystem</plugin>
            <param name="mock_sensor_commands">${mock_sensor_commands}</param>
            <param name="state_following_offset">0.0</param>
          </xacro:if>
          <xacro:unless value="${use_mock_hardware}">
            <plugin>dynamixel_hardware_interface/DynamixelHardware</plugin>
            <param name="port_name">${port_name}</param>
            <param name="baud_rate">4000000</param>
            <param name="dynamixel_model_folder">/param/dxl_model</param>
            <param name="number_of_joints">3</param>
            <param name="number_of_transmissions">3</param>
            <param name="disable_torque_at_init">true</param>
            <param name="dynamixel_state_pub_msg_name">ffw_mobile_base_steer/dxl_state</param>
            <param name="get_dynamixel_data_srv_name">ffw_mobile_base_steer/get_dxl_data</param>
            <param name="set_dynamixel_data_srv_name">ffw_mobile_base_steer/set_dxl_data</param>
            <param name="reboot_dxl_srv_name">ffw_mobile_base_steer/reboot_dxl</param>
            <param name="set_dxl_torque_srv_name">ffw_mobile_base_steer/set_dxl_torque</param>
          </xacro:unless>
        </hardware>
      </xacro:unless>

      <joint name="left_wheel_steer">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="right_wheel_steer">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="rear_wheel_steer">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <gpio name="dxl101">
        <param name="type">dxl</param>
        <param name="ID">101</param>
        <command_interface name="Goal Position"/>
        <state_interface name="Present Position"/>
        <state_interface name="Present Velocity"/>
        <state_interface name="Present Current"/>
        <state_interface name="Error Code"/>
        <param name="Drive Mode">5</param>
        <param name="Operating Mode">3</param>
        <param name="Velocity Limit">12592</param>
        <param name="Acceleration Limit">125920</param>
        <param name="Min Position Limit">-1572864</param>
        <param name="Max Position Limit">1572864</param>
        <param name="Acceleration Limit">1010</param>
        <param name="Return Delay Time">0</param>
        <param name="Profile Velocity">12592</param>
        <param name="Profile Acceleration Time">500</param>
        <param name="Profile Time">1000</param>
      </gpio>
      <gpio name="dxl103">
        <param name="type">dxl</param>
        <param name="ID">103</param>
        <command_interface name="Goal Position"/>
        <state_interface name="Present Position"/>
        <state_interface name="Present Velocity"/>
        <state_interface name="Present Current"/>
        <state_interface name="Error Code"/>
        <param name="Drive Mode">5</param>
        <param name="Operating Mode">3</param>
        <param name="Velocity Limit">12592</param>
        <param name="Acceleration Limit">125920</param>
        <param name="Min Position Limit">-1572864</param>
        <param name="Max Position Limit">1572864</param>
        <param name="Acceleration Limit">1010</param>
        <param name="Return Delay Time">0</param>
        <param name="Profile Velocity">12592</param>
        <param name="Profile Acceleration Time">500</param>
        <param name="Profile Time">1000</param>
      </gpio>
      <gpio name="dxl105">
        <param name="type">dxl</param>
        <param name="ID">105</param>
        <command_interface name="Goal Position"/>
        <state_interface name="Present Position"/>
        <state_interface name="Present Velocity"/>
        <state_interface name="Present Current"/>
        <state_interface name="Error Code"/>
        <param name="Drive Mode">5</param>
        <param name="Operating Mode">3</param>
        <param name="Velocity Limit">12592</param>
        <param name="Acceleration Limit">125920</param>
        <param name="Min Position Limit">-1572864</param>
        <param name="Max Position Limit">1572864</param>
        <param name="Acceleration Limit">1010</param>
        <param name="Return Delay Time">0</param>
        <param name="Profile Velocity">12592</param>
        <param name="Profile Acceleration Time">500</param>
        <param name="Profile Time">1000</param>
      </gpio>
    </ros2_control>
  </xacro:macro>

  <xacro:macro name="ffw_sg2_follower_system" params="use_sim:=^|false use_mock_hardware:=^|false mock_sensor_commands:=^|false port_name:=^|/dev/follower">
    <xacro:ffw_mobile_base_steer_system
      use_sim="${use_sim}"
      use_mock_hardware="${use_mock_hardware}"
      mock_sensor_commands="${mock_sensor_commands}"
      port_name="${port_name}"/>
  </xacro:macro>
</robot>
