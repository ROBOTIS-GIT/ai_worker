<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="hx5_d20_rev2_gazebo_link" params="reference">
    <gazebo reference="${reference}">
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <mu1>30.0</mu1>
      <mu2>30.0</mu2>
      <maxVel>1.0</maxVel>
      <minDepth>0.001</minDepth>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="hx5_d20_rev2_simple_transmission" params="name joint actuator">
    <transmission name="${name}">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${joint}">
        <hardwareInterface>PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="${actuator}">
        <mechanicalReduction>1</mechanicalReduction>
        <hardwareInterface>PositionJointInterface</hardwareInterface>
      </actuator>
    </transmission>
  </xacro:macro>

  <xacro:macro name="follower_hx5_joints_gazebo" params="prefix side index">
    <xacro:if value="${index != 21}">
      <xacro:hx5_d20_rev2_gazebo_link reference="${prefix}finger_${side}_link${index}" />
      <xacro:hx5_d20_rev2_simple_transmission name="${prefix}hand_${side}_trans${index}"
          joint="${prefix}finger_${side}_joint${index}"
          actuator="${prefix}hand_${side}_actuator${index}" />
      <xacro:follower_hx5_joints_gazebo
          prefix="${prefix}" side="${side}" index="${index + 1}" />
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="follower_hx5_side_gazebo" params="prefix side name">
    <xacro:hx5_d20_rev2_gazebo_link reference="${prefix}hx5_d20_${name}_base" />
    <xacro:follower_hx5_joints_gazebo prefix="${prefix}" side="${side}" index="${1}" />
  </xacro:macro>

  <xacro:macro name="follower_end_tool_gazebo" params="prefix">
    <xacro:follower_hx5_side_gazebo prefix="${prefix}" side="l" name="left" />
    <xacro:follower_hx5_side_gazebo prefix="${prefix}" side="r" name="right" />
  </xacro:macro>
</robot>
