<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="ffw_f_body_gazebo_link" params="reference">
    <gazebo reference="${reference}">
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <mu1>30.0</mu1>
      <mu2>30.0</mu2>
      <maxVel>1.0</maxVel>
      <minDepth>0.001</minDepth>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="ffw_f_body_simple_transmission" params="name joint actuator">
    <transmission name="${name}">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${joint}">
        <hardwareInterface>PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="${actuator}">
        <mechanicalReduction>1</mechanicalReduction>
        <hardwareInterface>PositionJointInterface</hardwareInterface>
      </actuator>
    </transmission>
  </xacro:macro>

  <xacro:macro name="ffw_f_arm_gazebo" params="prefix side">
    <xacro:ffw_f_body_gazebo_link reference="${prefix}arm_${side}_link1" />
    <xacro:ffw_f_body_gazebo_link reference="${prefix}arm_${side}_link2" />
    <xacro:ffw_f_body_gazebo_link reference="${prefix}arm_${side}_link3" />
    <xacro:ffw_f_body_gazebo_link reference="${prefix}arm_${side}_link4" />
    <xacro:ffw_f_body_gazebo_link reference="${prefix}arm_${side}_link5" />
    <xacro:ffw_f_body_gazebo_link reference="${prefix}arm_${side}_link6" />
    <xacro:ffw_f_body_gazebo_link reference="${prefix}arm_${side}_link7" />

    <xacro:ffw_f_body_simple_transmission name="${prefix}arm_${side}_trans1"
        joint="${prefix}arm_${side}_joint1" actuator="${prefix}arm_${side}_actuator1" />
    <xacro:ffw_f_body_simple_transmission name="${prefix}arm_${side}_trans2"
        joint="${prefix}arm_${side}_joint2" actuator="${prefix}arm_${side}_actuator2" />
    <xacro:ffw_f_body_simple_transmission name="${prefix}arm_${side}_trans3"
        joint="${prefix}arm_${side}_joint3" actuator="${prefix}arm_${side}_actuator3" />
    <xacro:ffw_f_body_simple_transmission name="${prefix}arm_${side}_trans4"
        joint="${prefix}arm_${side}_joint4" actuator="${prefix}arm_${side}_actuator4" />
    <xacro:ffw_f_body_simple_transmission name="${prefix}arm_${side}_trans5"
        joint="${prefix}arm_${side}_joint5" actuator="${prefix}arm_${side}_actuator5" />
    <xacro:ffw_f_body_simple_transmission name="${prefix}arm_${side}_trans6"
        joint="${prefix}arm_${side}_joint6" actuator="${prefix}arm_${side}_actuator6" />
    <xacro:ffw_f_body_simple_transmission name="${prefix}arm_${side}_trans7"
        joint="${prefix}arm_${side}_joint7" actuator="${prefix}arm_${side}_actuator7" />
  </xacro:macro>

  <xacro:macro name="follower_body_gazebo" params="prefix">
    <xacro:ffw_f_body_gazebo_link reference="${prefix}arm_base_link" />
    <xacro:ffw_f_body_gazebo_link reference="${prefix}head_link1" />
    <xacro:ffw_f_body_gazebo_link reference="${prefix}head_link2" />

    <xacro:ffw_f_body_simple_transmission name="${prefix}lift_trans"
        joint="${prefix}lift_joint" actuator="${prefix}lift_actuator" />
    <xacro:ffw_f_body_simple_transmission name="${prefix}head_trans1"
        joint="${prefix}head_joint1" actuator="${prefix}head_actuator1" />
    <xacro:ffw_f_body_simple_transmission name="${prefix}head_trans2"
        joint="${prefix}head_joint2" actuator="${prefix}head_actuator2" />

    <xacro:ffw_f_arm_gazebo prefix="${prefix}" side="l" />
    <xacro:ffw_f_arm_gazebo prefix="${prefix}" side="r" />
  </xacro:macro>
</robot>
