string arm
float64[] target
float64 duration_sec
# 기본 false: 기존과 동일 (target 비어 있으면 전 관절 kJointEffortOn).
# true 이면 target 은 무시하고 joint 2·4·6·7 만 kJointEffortOn, 나머지 0.
bool effort_joint_2467_preset
# true 이면 ramp 전에 해당 팔 궤적을 time=0·전부 0 으로 한 번 발행.
bool instant_zero_trajectory_first
# effort_joint_2467_preset 과 함께 true 일 때만 의미 있음. 관절 2·4·6·7 및 그 외 축은
# ramp 시작 시점 effort 유지, 관절 1 만 kJointEffortOn[0] 까지 선형 램프.
bool effort_hold_2467_ramp_joint1
# 위 preset/램프 플래그와 배타. true 이면 전 축은 ramp 시작 시점 effort 유지, 관절 3 만 kJointEffortOn[2] 까지 선형 램프.
bool effort_hold_all_ramp_joint3
# 0: 미사용. 1·3·5: SAFETY 준비「이동」후 — UI JOINT_ORDER(2→4→6→7→1→3→5) 기준 해당 관절 **앞선** 축만
# kJointEffortOn 으로 램프, 준비 관절(1·3·5) effort 는 0 유지, 그 뒤 순서 축은 시작 effort 유지.
# 위 effort_* ramp 플래그들과 배타.
int32 safety_prep_joint_number
---
bool success
string message
