<sdf version='1.10'>
  <world name='table_cube'>
    <physics name='1ms' type='ignored'>
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>

    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>5.5645e-06 2.28758e-05 -4.23884e-05</magnetic_field>
    <atmosphere type='adiabatic'/>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.72 0.74 0.78 1</background>
      <shadows>true</shadows>
    </scene>

    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.9</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <model name='ground_plane'>
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.78 0.78 0.78 1</ambient>
            <diffuse>0.78 0.78 0.78 1</diffuse>
            <specular>0.35 0.35 0.35 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name='table'>
      <static>true</static>
      <pose>0.8 0 0 0 0 0</pose>

      <link name='top'>
        <pose>0 0 0.72 0 0 0</pose>
        <collision name='collision'>
          <geometry>
            <box>
              <size>0.9 1.4 0.06</size>
            </box>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <box>
              <size>0.9 1.4 0.06</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.32 0.22 1</ambient>
            <diffuse>0.55 0.38 0.25 1</diffuse>
            <specular>0.15 0.1 0.07 1</specular>
          </material>
        </visual>
      </link>

      <link name='leg_front_left'>
        <pose>0.36 0.61 0.36 0 0 0</pose>
        <collision name='collision'>
          <geometry>
            <box>
              <size>0.06 0.06 0.72</size>
            </box>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <box>
              <size>0.06 0.06 0.72</size>
            </box>
          </geometry>
          <material>
            <ambient>0.36 0.25 0.16 1</ambient>
            <diffuse>0.45 0.32 0.2 1</diffuse>
          </material>
        </visual>
      </link>

      <link name='leg_front_right'>
        <pose>0.36 -0.61 0.36 0 0 0</pose>
        <collision name='collision'>
          <geometry>
            <box>
              <size>0.06 0.06 0.72</size>
            </box>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <box>
              <size>0.06 0.06 0.72</size>
            </box>
          </geometry>
          <material>
            <ambient>0.36 0.25 0.16 1</ambient>
            <diffuse>0.45 0.32 0.2 1</diffuse>
          </material>
        </visual>
      </link>

      <link name='leg_back_left'>
        <pose>-0.36 0.61 0.36 0 0 0</pose>
        <collision name='collision'>
          <geometry>
            <box>
              <size>0.06 0.06 0.72</size>
            </box>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <box>
              <size>0.06 0.06 0.72</size>
            </box>
          </geometry>
          <material>
            <ambient>0.36 0.25 0.16 1</ambient>
            <diffuse>0.45 0.32 0.2 1</diffuse>
          </material>
        </visual>
      </link>

      <link name='leg_back_right'>
        <pose>-0.36 -0.61 0.36 0 0 0</pose>
        <collision name='collision'>
          <geometry>
            <box>
              <size>0.06 0.06 0.72</size>
            </box>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <box>
              <size>0.06 0.06 0.72</size>
            </box>
          </geometry>
          <material>
            <ambient>0.36 0.25 0.16 1</ambient>
            <diffuse>0.45 0.32 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name='table_cylinder_bottle'>
      <pose>0.64 0 0 0 0 0</pose>
      <link name='body'>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.00024</ixx>
            <iyy>0.00024</iyy>
            <izz>0.00006</izz>
          </inertia>
        </inertial>
        <collision name='body_collision'>
          <pose>0 0 0.865 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.035</radius>
              <length>0.13</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name='body_visual'>
          <pose>0 0 0.865 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.035</radius>
              <length>0.13</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.22 0.9 1</ambient>
            <diffuse>0.05 0.35 1.0 1</diffuse>
            <specular>0.6 0.6 0.8 1</specular>
          </material>
        </visual>
        <collision name='neck_collision'>
          <pose>0 0 0.9475 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.018</radius>
              <length>0.035</length>
            </cylinder>
