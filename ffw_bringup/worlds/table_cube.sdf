        </visual>
        <collision name='cap_collision'>
          <pose>0 0 0.9725 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.022</radius>
              <length>0.015</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name='cap_visual'>
          <pose>0 0 0.9725 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.022</radius>
