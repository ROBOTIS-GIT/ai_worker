<?xml version="1.0"?>
<!--
articulated_cabinet: opening a drawer and a hinged lid.
A cabinet with one drawer (blue cube inside) and an orange box with a hinged
lid on top (green cube inside). Both models publish their joint positions on
/world/articulated_cabinet/model/<cabinet|lidded_box>/joint_state, so a task
can be checked by the drawer_joint / lid_joint values.
Example tasks: "open the drawer and take out the blue cube", "open the orange
box, put the red cube inside and close it".

Robot: spawned by the ffw_*_gazebo launch files at (0, 0) facing +x.
Base footprint: x -0.40..0.225 m, y -0.30..0.30 m. Units: metres, radians.
Graspable cubes are 5 cm / 50 g, the same as table.sdf.
-->
<sdf version='1.10'>
  <world name='articulated_cabinet'>
    <!-- 1 ms step: same as table.sdf, small enough for stable gripper contacts -->
    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>5.5645e-06 2.28758e-05 -4.23884e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name='visual'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- cabinet: front x=0.50, top z=0.75. One drawer (prismatic joint
         'drawer_joint', 0 = closed, 0.18 = fully open toward the robot).
         Handle bar at x=0.465, z=0.66: lower the lift to reach it. -->
    <model name='cabinet'>
      <pose>0.725 0 0 0 0 0</pose>
      <link name='body'>
        <inertial>
          <pose>0 0 0.375 0 0 0</pose>
          <mass>30</mass>
          <inertia>
            <ixx>3.00625</ixx><iyy>1.9125</iyy><izz>2.10625</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name='top_collision'>
          <pose>0 0 0.74 0 0 0</pose>
          <geometry><box><size>0.45 0.8 0.02</size></box></geometry>
        </collision>
        <visual name='top_visual'>
          <pose>0 0 0.74 0 0 0</pose>
          <geometry><box><size>0.45 0.8 0.02</size></box></geometry>
          <material>
            <ambient>0.82 0.8 0.76 1</ambient>
            <diffuse>0.82 0.8 0.76 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name='lower_block_collision'>
          <pose>0 0 0.275 0 0 0</pose>
          <geometry><box><size>0.45 0.8 0.55</size></box></geometry>
        </collision>
        <visual name='lower_block_visual'>
          <pose>0 0 0.275 0 0 0</pose>
          <geometry><box><size>0.45 0.8 0.55</size></box></geometry>
          <material>
            <ambient>0.3 0.38 0.45 1</ambient>
            <diffuse>0.3 0.38 0.45 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name='side_left_collision'>
          <pose>0 0.39 0.365 0 0 0</pose>
          <geometry><box><size>0.45 0.02 0.73</size></box></geometry>
        </collision>
        <visual name='side_left_visual'>
          <pose>0 0.39 0.365 0 0 0</pose>
          <geometry><box><size>0.45 0.02 0.73</size></box></geometry>
          <material>
            <ambient>0.3 0.38 0.45 1</ambient>
            <diffuse>0.3 0.38 0.45 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name='side_right_collision'>
          <pose>0 -0.39 0.365 0 0 0</pose>
          <geometry><box><size>0.45 0.02 0.73</size></box></geometry>
        </collision>
        <visual name='side_right_visual'>
          <pose>0 -0.39 0.365 0 0 0</pose>
          <geometry><box><size>0.45 0.02 0.73</size></box></geometry>
          <material>
            <ambient>0.3 0.38 0.45 1</ambient>
            <diffuse>0.3 0.38 0.45 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name='fill_left_collision'>
          <pose>0 0.2925 0.64 0 0 0</pose>
          <geometry><box><size>0.45 0.175 0.18</size></box></geometry>
        </collision>
        <visual name='fill_left_visual'>
          <pose>0 0.2925 0.64 0 0 0</pose>
          <geometry><box><size>0.45 0.175 0.18</size></box></geometry>
          <material>
            <ambient>0.3 0.38 0.45 1</ambient>
            <diffuse>0.3 0.38 0.45 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name='fill_right_collision'>
          <pose>0 -0.2925 0.64 0 0 0</pose>
          <geometry><box><size>0.45 0.175 0.18</size></box></geometry>
        </collision>
        <visual name='fill_right_visual'>
          <pose>0 -0.2925 0.64 0 0 0</pose>
          <geometry><box><size>0.45 0.175 0.18</size></box></geometry>
          <material>
            <ambient>0.3 0.38 0.45 1</ambient>
            <diffuse>0.3 0.38 0.45 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name='back_collision'>
          <pose>0.215 0 0.64 0 0 0</pose>
          <geometry><box><size>0.02 0.41 0.18</size></box></geometry>
        </collision>
        <visual name='back_visual'>
          <pose>0.215 0 0.64 0 0 0</pose>
          <geometry><box><size>0.02 0.41 0.18</size></box></geometry>
          <material>
            <ambient>0.3 0.38 0.45 1</ambient>
            <diffuse>0.3 0.38 0.45 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <link name='drawer'>
        <inertial>
          <pose>-0.027 0 0.61 0 0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>0.012</ixx><iyy>0.012</iyy><izz>0.02</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name='front_plate_collision'>
          <pose>-0.214 0 0.64 0 0 0</pose>
          <geometry><box><size>0.018 0.39 0.17</size></box></geometry>
        </collision>
        <visual name='front_plate_visual'>
          <pose>-0.214 0 0.64 0 0 0</pose>
          <geometry><box><size>0.018 0.39 0.17</size></box></geometry>
          <material>
            <ambient>0.76 0.6 0.42 1</ambient>
            <diffuse>0.76 0.6 0.42 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name='bottom_collision'>
          <pose>-0.027 0 0.56 0 0 0</pose>
          <geometry><box><size>0.36 0.39 0.01</size></box></geometry>
        </collision>
        <visual name='bottom_visual'>
          <pose>-0.027 0 0.56 0 0 0</pose>
          <geometry><box><size>0.36 0.39 0.01</size></box></geometry>
          <material>
            <ambient>0.55 0.4 0.25 1</ambient>
            <diffuse>0.55 0.4 0.25 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name='wall_left_collision'>
          <pose>-0.027 0.19 0.61 0 0 0</pose>
          <geometry><box><size>0.36 0.01 0.11</size></box></geometry>
        </collision>
        <visual name='wall_left_visual'>
          <pose>-0.027 0.19 0.61 0 0 0</pose>
          <geometry><box><size>0.36 0.01 0.11</size></box></geometry>
          <material>
            <ambient>0.55 0.4 0.25 1</ambient>
            <diffuse>0.55 0.4 0.25 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name='wall_right_collision'>
          <pose>-0.027 -0.19 0.61 0 0 0</pose>
          <geometry><box><size>0.36 0.01 0.11</size></box></geometry>
        </collision>
        <visual name='wall_right_visual'>
          <pose>-0.027 -0.19 0.61 0 0 0</pose>
          <geometry><box><size>0.36 0.01 0.11</size></box></geometry>
          <material>
            <ambient>0.55 0.4 0.25 1</ambient>
            <diffuse>0.55 0.4 0.25 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name='wall_back_collision'>
          <pose>0.148 0 0.61 0 0 0</pose>
          <geometry><box><size>0.01 0.39 0.11</size></box></geometry>
        </collision>
        <visual name='wall_back_visual'>
          <pose>0.148 0 0.61 0 0 0</pose>
          <geometry><box><size>0.01 0.39 0.11</size></box></geometry>
          <material>
            <ambient>0.55 0.4 0.25 1</ambient>
            <diffuse>0.55 0.4 0.25 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name='handle_bar_collision'>
          <pose>-0.26 0 0.66 0 0 0</pose>
          <geometry><box><size>0.02 0.16 0.02</size></box></geometry>
        </collision>
        <visual name='handle_bar_visual'>
          <pose>-0.26 0 0.66 0 0 0</pose>
          <geometry><box><size>0.02 0.16 0.02</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.38 1</ambient>
            <diffuse>0.35 0.35 0.38 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name='handle_post_l_collision'>
          <pose>-0.2325 0.07 0.66 0 0 0</pose>
          <geometry><box><size>0.035 0.015 0.015</size></box></geometry>
        </collision>
        <visual name='handle_post_l_visual'>
          <pose>-0.2325 0.07 0.66 0 0 0</pose>
          <geometry><box><size>0.035 0.015 0.015</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.38 1</ambient>
            <diffuse>0.35 0.35 0.38 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name='handle_post_r_collision'>
          <pose>-0.2325 -0.07 0.66 0 0 0</pose>
          <geometry><box><size>0.035 0.015 0.015</size></box></geometry>
        </collision>
        <visual name='handle_post_r_visual'>
          <pose>-0.2325 -0.07 0.66 0 0 0</pose>
          <geometry><box><size>0.035 0.015 0.015</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.38 1</ambient>
            <diffuse>0.35 0.35 0.38 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <joint name='fixed_to_world' type='fixed'>
        <parent>world</parent>
        <child>body</child>
      </joint>
      <joint name='drawer_joint' type='prismatic'>
        <parent>body</parent>
        <child>drawer</child>
        <axis>
          <xyz>-1 0 0</xyz>
          <limit><lower>0</lower><upper>0.18</upper><effort>100</effort><velocity>1</velocity></limit>
          <dynamics><damping>8</damping><friction>0.5</friction></dynamics>
        </axis>
      </joint>
      <!-- joint positions on gz topic /world/articulated_cabinet/model/<model>/joint_state -->
      <plugin name='gz::sim::systems::JointStatePublisher' filename='gz-sim-joint-state-publisher-system'/>
    </model>

    <!-- lidded_box: orange box (inner 18x18x10 cm) on the cabinet top. The lid
         hinges at its back edge ('lid_joint', 0 = closed, opens upward to
         1.9 rad). Lift the black knob at the front edge to open it. -->
    <model name='lidded_box'>
      <pose>0.62 -0.2 0.75 0 0 0</pose>
      <link name='box'>
        <inertial>
          <pose>0 0 0.05 0 0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>0.00416667</ixx><iyy>0.00416667</iyy><izz>0.00666667</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name='bottom_collision'>
          <pose>0 0 0.0025 0 0 0</pose>
          <geometry><box><size>0.2 0.2 0.005</size></box></geometry>
        </collision>
        <visual name='bottom_visual'>
          <pose>0 0 0.0025 0 0 0</pose>
          <geometry><box><size>0.2 0.2 0.005</size></box></geometry>
          <material>
            <ambient>0.95 0.45 0.05 1</ambient>
            <diffuse>0.95 0.45 0.05 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name='wall_px_collision'>
          <pose>0.095 0 0.05 0 0 0</pose>
          <geometry><box><size>0.01 0.2 0.1</size></box></geometry>
        </collision>
        <visual name='wall_px_visual'>
          <pose>0.095 0 0.05 0 0 0</pose>
          <geometry><box><size>0.01 0.2 0.1</size></box></geometry>
          <material>
            <ambient>0.95 0.45 0.05 1</ambient>
            <diffuse>0.95 0.45 0.05 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name='wall_nx_collision'>
          <pose>-0.095 0 0.05 0 0 0</pose>
          <geometry><box><size>0.01 0.2 0.1</size></box></geometry>
        </collision>
        <visual name='wall_nx_visual'>
          <pose>-0.095 0 0.05 0 0 0</pose>
          <geometry><box><size>0.01 0.2 0.1</size></box></geometry>
          <material>
            <ambient>0.95 0.45 0.05 1</ambient>
            <diffuse>0.95 0.45 0.05 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name='wall_py_collision'>
          <pose>0 0.095 0.05 0 0 0</pose>
          <geometry><box><size>0.18 0.01 0.1</size></box></geometry>
        </collision>
        <visual name='wall_py_visual'>
          <pose>0 0.095 0.05 0 0 0</pose>
          <geometry><box><size>0.18 0.01 0.1</size></box></geometry>
          <material>
            <ambient>0.95 0.45 0.05 1</ambient>
            <diffuse>0.95 0.45 0.05 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name='wall_ny_collision'>
          <pose>0 -0.095 0.05 0 0 0</pose>
          <geometry><box><size>0.18 0.01 0.1</size></box></geometry>
        </collision>
        <visual name='wall_ny_visual'>
          <pose>0 -0.095 0.05 0 0 0</pose>
          <geometry><box><size>0.18 0.01 0.1</size></box></geometry>
          <material>
            <ambient>0.95 0.45 0.05 1</ambient>
            <diffuse>0.95 0.45 0.05 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <link name='lid'>
        <pose>0.1 0 0.1 0 0 0</pose>
        <inertial>
          <pose>-0.1 0 0.005 0 0 0</pose>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0004</ixx><iyy>0.0004</iyy><izz>0.0008</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name='lid_collision'>
          <pose>-0.1 0 0.005 0 0 0</pose>
          <geometry><box><size>0.2 0.2 0.01</size></box></geometry>
        </collision>
        <visual name='lid_visual'>
          <pose>-0.1 0 0.005 0 0 0</pose>
          <geometry><box><size>0.2 0.2 0.01</size></box></geometry>
          <material>
            <ambient>0.95 0.45 0.05 1</ambient>
            <diffuse>0.95 0.45 0.05 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name='knob_collision'>
          <pose>-0.1875 0 0.0225 0 0 0</pose>
          <geometry><box><size>0.025 0.04 0.025</size></box></geometry>
        </collision>
        <visual name='knob_visual'>
          <pose>-0.1875 0 0.0225 0 0 0</pose>
          <geometry><box><size>0.025 0.04 0.025</size></box></geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <joint name='fixed_to_world' type='fixed'>
        <parent>world</parent>
        <child>box</child>
      </joint>
      <joint name='lid_joint' type='revolute'>
        <parent>box</parent>
        <child>lid</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>0</lower><upper>1.9</upper><effort>10</effort><velocity>2</velocity></limit>
          <dynamics><damping>0.05</damping><friction>0.01</friction></dynamics>
        </axis>
      </joint>
      <!-- joint positions on gz topic /world/articulated_cabinet/model/<model>/joint_state -->
      <plugin name='gz::sim::systems::JointStatePublisher' filename='gz-sim-joint-state-publisher-system'/>
    </model>

    <!-- red_cube: on the cabinet top, left -->
    <model name='red_cube'>
      <pose>0.58 0.22 0.775 0 0 0</pose>
      <link name='link'>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>2.08333e-05</ixx><iyy>2.08333e-05</iyy><izz>2.08333e-05</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name='collision'>
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material>
            <ambient>0.85 0.1 0.1 1</ambient>
            <diffuse>0.85 0.1 0.1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- blue_cube: inside the closed drawer (moves with it when opened) -->
    <model name='blue_cube'>
      <pose>0.66 0 0.59 0 0 0</pose>
      <link name='link'>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>2.08333e-05</ixx><iyy>2.08333e-05</iyy><izz>2.08333e-05</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name='collision'>
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material>
            <ambient>0.1 0.2 0.9 1</ambient>
            <diffuse>0.1 0.2 0.9 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- green_cube: inside the closed lidded box -->
    <model name='green_cube'>
      <pose>0.62 -0.2 0.78 0 0 0</pose>
      <link name='link'>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>2.08333e-05</ixx><iyy>2.08333e-05</iyy><izz>2.08333e-05</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name='collision'>
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material>
            <ambient>0.1 0.7 0.15 1</ambient>
            <diffuse>0.1 0.7 0.15 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
