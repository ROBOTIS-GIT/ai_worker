<?xml version="1.0"?>
<!--
shelf_lift: reaching at two heights with the lift and head.
A two-level shelf with its front at x=1.20, out of the arms' reach from the
spawn point, so the robot first drives forward about 0.8 m (stop with the base
front, x=+0.225 in base_link, short of the shelf). The top surface (z=0.88) is
reachable at the default lift height; the lower level (z=0.40) needs the lift
lowered and the head tilted.
Example tasks: "take the green cube from the lower shelf and put it on the
orange square", "put the red cube in the lower right compartment".

Robot: spawned by the ffw_*_gazebo launch files at (0, 0) facing +x.
Base footprint: x -0.40..0.225 m, y -0.30..0.30 m. Units: metres, radians.
Graspable cubes are 5 cm / 50 g, the same as table.sdf.
-->
<sdf version='1.10'>
  <world name='shelf_lift'>
    <!-- 1 ms step: same as table.sdf, small enough for stable gripper contacts -->
    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>5.5645e-06 2.28758e-05 -4.23884e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name='visual'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- shelf: front x=1.20, 35 cm deep, out of reach from the spawn point. Drive forward about 0.8 m. Lower level z=0.40 (left/right compartments split at y=0), top surface z=0.88 -->
    <model name='shelf'>
      <static>true</static>
      <pose>1.375 0 0 0 0 0</pose>
      <link name='link'>
        <collision name='base_block_collision'>
          <pose>0 0 0.2 0 0 0</pose>
          <geometry><box><size>0.35 1 0.4</size></box></geometry>
        </collision>
        <visual name='base_block_visual'>
          <pose>0 0 0.2 0 0 0</pose>
          <geometry><box><size>0.35 1 0.4</size></box></geometry>
          <material>
            <ambient>0.76 0.6 0.42 1</ambient>
            <diffuse>0.76 0.6 0.42 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name='top_board_collision'>
          <pose>0 0 0.87 0 0 0</pose>
          <geometry><box><size>0.35 1 0.02</size></box></geometry>
        </collision>
        <visual name='top_board_visual'>
          <pose>0 0 0.87 0 0 0</pose>
          <geometry><box><size>0.35 1 0.02</size></box></geometry>
          <material>
            <ambient>0.76 0.6 0.42 1</ambient>
            <diffuse>0.76 0.6 0.42 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name='side_left_collision'>
          <pose>0 0.49 0.44 0 0 0</pose>
          <geometry><box><size>0.35 0.02 0.88</size></box></geometry>
        </collision>
        <visual name='side_left_visual'>
          <pose>0 0.49 0.44 0 0 0</pose>
          <geometry><box><size>0.35 0.02 0.88</size></box></geometry>
          <material>
            <ambient>0.55 0.4 0.25 1</ambient>
            <diffuse>0.55 0.4 0.25 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name='side_right_collision'>
          <pose>0 -0.49 0.44 0 0 0</pose>
          <geometry><box><size>0.35 0.02 0.88</size></box></geometry>
        </collision>
        <visual name='side_right_visual'>
          <pose>0 -0.49 0.44 0 0 0</pose>
          <geometry><box><size>0.35 0.02 0.88</size></box></geometry>
          <material>
            <ambient>0.55 0.4 0.25 1</ambient>
            <diffuse>0.55 0.4 0.25 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name='back_collision'>
          <pose>0.165 0 0.44 0 0 0</pose>
          <geometry><box><size>0.02 1 0.88</size></box></geometry>
        </collision>
        <visual name='back_visual'>
          <pose>0.165 0 0.44 0 0 0</pose>
          <geometry><box><size>0.02 1 0.88</size></box></geometry>
          <material>
            <ambient>0.55 0.4 0.25 1</ambient>
            <diffuse>0.55 0.4 0.25 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name='divider_collision'>
          <pose>-0.01 0 0.63 0 0 0</pose>
          <geometry><box><size>0.33 0.02 0.46</size></box></geometry>
        </collision>
        <visual name='divider_visual'>
          <pose>-0.01 0 0.63 0 0 0</pose>
          <geometry><box><size>0.33 0.02 0.46</size></box></geometry>
          <material>
            <ambient>0.55 0.4 0.25 1</ambient>
            <diffuse>0.55 0.4 0.25 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- lower level, left compartment -->
    <model name='green_cube'>
      <pose>1.28 0.22 0.425 0 0 0</pose>
      <link name='link'>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>2.08333e-05</ixx><iyy>2.08333e-05</iyy><izz>2.08333e-05</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name='collision'>
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material>
            <ambient>0.1 0.7 0.15 1</ambient>
            <diffuse>0.1 0.7 0.15 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- lower level, right compartment -->
    <model name='yellow_cylinder'>
      <pose>1.28 -0.22 0.435 0 0 0</pose>
      <link name='link'>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>2.82292e-05</ixx><iyy>2.82292e-05</iyy><izz>1.5625e-05</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name='collision'>
          <geometry><cylinder><radius>0.025</radius><length>0.07</length></cylinder></geometry>
        </collision>
        <visual name='visual'>
          <geometry><cylinder><radius>0.025</radius><length>0.07</length></cylinder></geometry>
          <material>
            <ambient>0.95 0.8 0.05 1</ambient>
            <diffuse>0.95 0.8 0.05 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- top surface -->
    <model name='red_cube'>
      <pose>1.28 0.2 0.905 0 0 0</pose>
      <link name='link'>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>2.08333e-05</ixx><iyy>2.08333e-05</iyy><izz>2.08333e-05</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name='collision'>
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material>
            <ambient>0.85 0.1 0.1 1</ambient>
            <diffuse>0.85 0.1 0.1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- top surface -->
    <model name='blue_cube'>
      <pose>1.28 -0.2 0.905 0 0 0</pose>
      <link name='link'>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>2.08333e-05</ixx><iyy>2.08333e-05</iyy><izz>2.08333e-05</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name='collision'>
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material>
            <ambient>0.1 0.2 0.9 1</ambient>
            <diffuse>0.1 0.2 0.9 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- top_target: 12x12 cm orange area on the top surface -->
    <model name='top_target'>
      <static>true</static>
      <pose>1.3 0 0.881 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>0.12 0.12 0.002</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.12 0.12 0.002</size></box></geometry>
          <material>
            <ambient>0.95 0.45 0.05 1</ambient>
            <diffuse>0.95 0.45 0.05 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
