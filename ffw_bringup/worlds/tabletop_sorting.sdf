            <diffuse>0.1 0.2 0.9 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- yellow_cylinder: r 2.5 cm, h 7 cm, 50 g -->
    <model name='yellow_cylinder'>
      <pose>0.58 0 0.885 0 0 0</pose>
      <link name='link'>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>2.82292e-05</ixx><iyy>2.82292e-05</iyy><izz>1.5625e-05</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name='collision'>
          <geometry><cylinder><radius>0.025</radius><length>0.07</length></cylinder></geometry>
        </collision>
        <visual name='visual'>
          <geometry><cylinder><radius>0.025</radius><length>0.07</length></cylinder></geometry>
          <material>
            <ambient>0.95 0.8 0.05 1</ambient>
            <diffuse>0.95 0.8 0.05 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
