<?xml version="1.0"?>
<!--
kitchen_counter: language-grounded pick-and-place with everyday objects.
Objects are named after what they look like (plate, bowl, cans, apple, cereal
box, sponge, cutting board) and built from primitive shapes only.
Example tasks: "put the apple in the bowl", "put the red can on the plate",
"place the sponge on the cutting board".

Robot: spawned by the ffw_*_gazebo launch files at (0, 0) facing +x.
Base footprint: x -0.40..0.225 m, y -0.30..0.30 m. Units: metres, radians.
Graspable cubes are 5 cm / 50 g, the same as table.sdf.
-->
<sdf version='1.10'>
  <world name='kitchen_counter'>
    <!-- 1 ms step: same as table.sdf, small enough for stable gripper contacts -->
    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>5.5645e-06 2.28758e-05 -4.23884e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name='visual'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- counter: front edge x=0.35, top z=0.85, 1.4 m wide -->
    <model name='counter'>
      <static>true</static>
      <pose>0.625 0 0 0 0 0</pose>
      <link name='link'>
        <collision name='cabinet_collision'>
          <pose>0.025 0 0.405 0 0 0</pose>
          <geometry><box><size>0.5 1.4 0.81</size></box></geometry>
        </collision>
        <visual name='cabinet_visual'>
          <pose>0.025 0 0.405 0 0 0</pose>
          <geometry><box><size>0.5 1.4 0.81</size></box></geometry>
          <material>
            <ambient>0.3 0.38 0.45 1</ambient>
            <diffuse>0.3 0.38 0.45 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name='top_collision'>
          <pose>0 0 0.83 0 0 0</pose>
          <geometry><box><size>0.55 1.4 0.04</size></box></geometry>
        </collision>
        <visual name='top_visual'>
          <pose>0 0 0.83 0 0 0</pose>
          <geometry><box><size>0.55 1.4 0.04</size></box></geometry>
          <material>
            <ambient>0.82 0.8 0.76 1</ambient>
            <diffuse>0.82 0.8 0.76 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- plate: r 9 cm, 1.2 cm thick, 200 g -->
    <model name='plate'>
      <pose>0.58 0 0.856 0 0 0</pose>
      <link name='link'>
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.0004074</ixx><iyy>0.0004074</iyy><izz>0.00081</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name='collision'>
          <geometry><cylinder><radius>0.09</radius><length>0.012</length></cylinder></geometry>
        </collision>
        <visual name='visual'>
          <geometry><cylinder><radius>0.09</radius><length>0.012</length></cylinder></geometry>
          <material>
            <ambient>0.92 0.92 0.92 1</ambient>
            <diffuse>0.92 0.92 0.92 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- cutting_board: 15x15 cm -->
    <model name='cutting_board'>
      <pose>0.6 -0.27 0.8575 0 0 0</pose>
      <link name='link'>
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.00037875</ixx><iyy>0.00037875</iyy><izz>0.00075</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name='collision'>
          <geometry><box><size>0.15 0.15 0.015</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.15 0.15 0.015</size></box></geometry>
          <material>
            <ambient>0.76 0.6 0.42 1</ambient>
            <diffuse>0.76 0.6 0.42 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- bowl: square bowl, inner 12x12x5 cm, 150 g -->
    <model name='bowl'>
      <pose>0.6 0.25 0.85 0 0 0</pose>
      <link name='link'>
        <inertial>
          <pose>0 0 0.018 0 0 0</pose>
          <mass>0.15</mass>
          <inertia>
            <ixx>0.00027625</ixx><iyy>0.00027625</iyy><izz>0.00049</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name='bottom_collision'>
          <pose>0 0 0.0025 0 0 0</pose>
          <geometry><box><size>0.14 0.14 0.005</size></box></geometry>
        </collision>
        <visual name='bottom_visual'>
          <pose>0 0 0.0025 0 0 0</pose>
          <geometry><box><size>0.14 0.14 0.005</size></box></geometry>
          <material>
            <ambient>0.92 0.92 0.92 1</ambient>
            <diffuse>0.92 0.92 0.92 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name='wall_px_collision'>
          <pose>0.065 0 0.025 0 0 0</pose>
          <geometry><box><size>0.01 0.14 0.05</size></box></geometry>
        </collision>
        <visual name='wall_px_visual'>
          <pose>0.065 0 0.025 0 0 0</pose>
          <geometry><box><size>0.01 0.14 0.05</size></box></geometry>
          <material>
            <ambient>0.92 0.92 0.92 1</ambient>
            <diffuse>0.92 0.92 0.92 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name='wall_nx_collision'>
          <pose>-0.065 0 0.025 0 0 0</pose>
          <geometry><box><size>0.01 0.14 0.05</size></box></geometry>
        </collision>
        <visual name='wall_nx_visual'>
          <pose>-0.065 0 0.025 0 0 0</pose>
          <geometry><box><size>0.01 0.14 0.05</size></box></geometry>
          <material>
            <ambient>0.92 0.92 0.92 1</ambient>
            <diffuse>0.92 0.92 0.92 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name='wall_py_collision'>
          <pose>0 0.065 0.025 0 0 0</pose>
          <geometry><box><size>0.12 0.01 0.05</size></box></geometry>
        </collision>
        <visual name='wall_py_visual'>
          <pose>0 0.065 0.025 0 0 0</pose>
          <geometry><box><size>0.12 0.01 0.05</size></box></geometry>
          <material>
            <ambient>0.92 0.92 0.92 1</ambient>
            <diffuse>0.92 0.92 0.92 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name='wall_ny_collision'>
          <pose>0 -0.065 0.025 0 0 0</pose>
          <geometry><box><size>0.12 0.01 0.05</size></box></geometry>
        </collision>
        <visual name='wall_ny_visual'>
          <pose>0 -0.065 0.025 0 0 0</pose>
          <geometry><box><size>0.12 0.01 0.05</size></box></geometry>
          <material>
            <ambient>0.92 0.92 0.92 1</ambient>
            <diffuse>0.92 0.92 0.92 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- red_can: r 2.6 cm, h 10 cm, 80 g -->
    <model name='red_can'>
      <pose>0.44 -0.18 0.9 0 0 0</pose>
      <link name='link'>
        <inertial>
          <mass>0.08</mass>
          <inertia>
            <ixx>8.01867e-05</ixx><iyy>8.01867e-05</iyy><izz>2.704e-05</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name='collision'>
          <geometry><cylinder><radius>0.026</radius><length>0.1</length></cylinder></geometry>
        </collision>
        <visual name='visual'>
          <geometry><cylinder><radius>0.026</radius><length>0.1</length></cylinder></geometry>
          <material>
            <ambient>0.85 0.1 0.1 1</ambient>
            <diffuse>0.85 0.1 0.1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- green_can: r 2.6 cm, h 10 cm, 80 g -->
    <model name='green_can'>
      <pose>0.44 0.18 0.9 0 0 0</pose>
      <link name='link'>
        <inertial>
          <mass>0.08</mass>
          <inertia>
            <ixx>8.01867e-05</ixx><iyy>8.01867e-05</iyy><izz>2.704e-05</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name='collision'>
          <geometry><cylinder><radius>0.026</radius><length>0.1</length></cylinder></geometry>
        </collision>
        <visual name='visual'>
          <geometry><cylinder><radius>0.026</radius><length>0.1</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.7 0.15 1</ambient>
            <diffuse>0.1 0.7 0.15 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- apple: sphere r 2.5 cm, 60 g (rolls if pushed) -->
    <model name='apple'>
      <pose>0.44 0 0.875 0 0 0</pose>
      <link name='link'>
        <inertial>
          <mass>0.06</mass>
          <inertia>
            <ixx>1.5e-05</ixx><iyy>1.5e-05</iyy><izz>1.5e-05</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name='collision'>
          <geometry><sphere><radius>0.025</radius></sphere></geometry>
        </collision>
        <visual name='visual'>
          <geometry><sphere><radius>0.025</radius></sphere></geometry>
          <material>
            <ambient>0.85 0.1 0.1 1</ambient>
            <diffuse>0.85 0.1 0.1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- cereal_box: 5x12x18 cm, 150 g. Grasp across the 5 cm side -->
    <model name='cereal_box'>
      <pose>0.48 0.42 0.94 0 0 0</pose>
      <link name='link'>
        <inertial>
          <mass>0.15</mass>
          <inertia>
            <ixx>0.000585</ixx><iyy>0.00043625</iyy><izz>0.00021125</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name='collision'>
          <geometry><box><size>0.05 0.12 0.18</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.05 0.12 0.18</size></box></geometry>
          <material>
            <ambient>0.95 0.8 0.05 1</ambient>
            <diffuse>0.95 0.8 0.05 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- sponge: 4x7x3 cm, 20 g -->
    <model name='sponge'>
      <pose>0.62 -0.42 0.865 0 0 0</pose>
      <link name='link'>
        <inertial>
          <mass>0.02</mass>
          <inertia>
            <ixx>9.66667e-06</ixx><iyy>4.16667e-06</iyy><izz>1.08333e-05</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name='collision'>
          <geometry><box><size>0.04 0.07 0.03</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.04 0.07 0.03</size></box></geometry>
          <material>
            <ambient>0.1 0.7 0.15 1</ambient>
            <diffuse>0.1 0.7 0.15 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
