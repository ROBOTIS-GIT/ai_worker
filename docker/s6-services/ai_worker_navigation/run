#!/command/with-contenv bash
# AI Worker Navigation - Nav2 mapping/navigation launcher

set -e

SERVICE_NAME="ai_worker_navigation"
COMMON_SCRIPT="/usr/local/lib/s6-services/ros2_service_run.sh"
ROS2_COMMAND="ros2 launch ffw_navigation navigation.launch.py"
ROS2_MAP_NAME_ARG_DIR="/root/ros2_ws/src/ai_worker/ffw_navigation/maps"

if [ -f "${COMMON_SCRIPT}" ]; then
  export SERVICE_NAME="${SERVICE_NAME}"
  export ROS2_COMMAND="${ROS2_COMMAND}"
  export ROS2_MAP_NAME_ARG_DIR="${ROS2_MAP_NAME_ARG_DIR}"
  exec /command/with-contenv env SERVICE_NAME="${SERVICE_NAME}" ROS2_COMMAND="${ROS2_COMMAND}" ROS2_MAP_NAME_ARG_DIR="${ROS2_MAP_NAME_ARG_DIR}" bash -i -c "${COMMON_SCRIPT}"
else
  echo "Error: Common script not found at ${COMMON_SCRIPT}" >&2
  exit 1
fi
