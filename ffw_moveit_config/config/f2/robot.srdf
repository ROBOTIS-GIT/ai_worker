  <disable_collisions link1="gripper_l_hx2_d1_l1" link2="gripper_l_hx2_d1_r1" reason="Gripper linkage" />
  <disable_collisions link1="gripper_l_hx2_d1_l1" link2="gripper_l_hx2_d1_r2" reason="Gripper linkage" />
  <disable_collisions link1="gripper_l_hx2_d1_l2" link2="gripper_l_hx2_d1_r1" reason="Gripper linkage" />
  <disable_collisions link1="gripper_l_hx2_d1_l2" link2="gripper_l_hx2_d1_r2" reason="Gripper linkage" />
  <disable_collisions link1="gripper_l_hx2_d1_r1" link2="gripper_l_hx2_d1_r2" reason="Gripper linkage" />
  <disable_collisions link1="gripper_r_hx2_d1_base" link2="gripper_r_hx2_d1_l1" reason="Gripper linkage" />
  <disable_collisions link1="gripper_r_hx2_d1_base" link2="gripper_r_hx2_d1_l2" reason="Gripper linkage" />
  <disable_collisions link1="gripper_r_hx2_d1_base" link2="gripper_r_hx2_d1_r1" reason="Gripper linkage" />
  <disable_collisions link1="gripper_r_hx2_d1_base" link2="gripper_r_hx2_d1_r2" reason="Gripper linkage" />
  <disable_collisions link1="gripper_r_hx2_d1_l1" link2="gripper_r_hx2_d1_l2" reason="Gripper linkage" />
  <disable_collisions link1="gripper_r_hx2_d1_l1" link2="gripper_r_hx2_d1_r1" reason="Gripper linkage" />
  <disable_collisions link1="gripper_r_hx2_d1_l1" link2="gripper_r_hx2_d1_r2" reason="Gripper linkage" />
  <disable_collisions link1="gripper_r_hx2_d1_l2" link2="gripper_r_hx2_d1_r1" reason="Gripper linkage" />
  <disable_collisions link1="gripper_r_hx2_d1_l2" link2="gripper_r_hx2_d1_r2" reason="Gripper linkage" />
  <disable_collisions link1="gripper_r_hx2_d1_r1" link2="gripper_r_hx2_d1_r2" reason="Gripper linkage" />
  <disable_collisions link1="head_link1" link2="head_link2" reason="Adjacent" />
  <disable_collisions link1="left_wheel_drive_link" link2="left_wheel_steer_link" reason="Adjacent" />
  <disable_collisions link1="left_wheel_steer_link" link2="lift_link" reason="Adjacent" />
  <disable_collisions link1="lift_link" link2="rear_wheel_steer_link" reason="Adjacent" />
  <disable_collisions link1="lift_link" link2="right_wheel_steer_link" reason="Adjacent" />
  <disable_collisions link1="rear_wheel_drive_link" link2="rear_wheel_steer_link" reason="Adjacent" />
